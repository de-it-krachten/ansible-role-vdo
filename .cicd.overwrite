---

# Generic
generic:
  role: ansible-role-vdo
  role_short: vdo
  role_description: |
    Installs and configurtion VDO support
  collections: []

# Supported platforms
platforms:
#  rhel7:
#    ci: false
#    supported: false
#  rhel8:
#    ci: false
#    supported: false
#  rhel9:
#    ci: false
#    supported: false
#  rhel10:
#    ci: false
#    supported: false
#  centos7:
#    ci: false
#    supported: false
#  centos8:
