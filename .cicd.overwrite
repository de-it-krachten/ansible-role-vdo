# Molecule
molecule:
  requirements:
    roles_extra:
      - name: deitkrachten.lvm
        version: dev
  prepare:
    vars:
      update_all: true
  converge:
    vars:
      vdo_lvm:
        vg:
          - name: vgvdo
            pv: [ '3:0:0:0' ]
            pvresize: true
        lv:
          - name: lvvdo1
            type: vdo
            size: 5G
            pool_name: vpool0
            virtualsize: 10G
            vg: vgvdo
            fstype: xfs
            mp: /vdo1
      vdo_lvm2:
        vg:
          - name: vgvdo
            pv: [ '3:0:0:0' ]
            pvresize: true
        lv:
          - name: lvvdo1
            type: vdo
            size: 9G
            pool_name: vpool0
            virtualsize: 40G
            vg: vgvdo
            fstype: xfs
            mp: /vdo1
