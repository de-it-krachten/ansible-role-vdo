#    supported: false
#  centos8s:
#    ci: false
#    supported: false
#  centos9s:
#    ci: false
#    supported: false
#  centos10s:
#    ci: false
#    supported: false
  rockylinux8:
    molecule:
      vagrant: 
        interfaces: []
        provider_raw_config_args:
          - "customize ['createhd', '--filename', 'vdo-rockylinux8-node1-disk1.vdi', '--size', 10240]"
          - "customize ['storageattach', :id, '--storagectl', 'SATA Controller', '--port', 1, '--device', 0, '--type', 'hdd', '--medium', 'vdo-rockylinux8-node1-disk1.vdi']"
  rockylinux9:
    molecule:
      vagrant: 
        interfaces: []
        provider_raw_config_args:
          - "customize ['createhd', '--filename', 'vdo-rockylinux9-node1-disk1.vdi', '--size', 10240]"
          - "customize ['storageattach', :id, '--storagectl', 'SATA Controller', '--port', 1, '--device', 0, '--type', 'hdd', '--medium', 'vdo-rockylinux9-node1-disk1.vdi']"
  rockylinux10:
    molecule:
      vagrant: 
        box: "cloud-image/rocky-10"
        interfaces: []
        provider_raw_config_args:
          - "customize ['createhd', '--filename', 'vdo-rockylinux10-node1-disk1.vdi', '--size', 10240]"
          - "customize ['storageattach', :id, '--storagectl', 'VirtIO Controller', '--port', 1, '--device', 0, '--type', 'hdd', '--medium', 'vdo-rockylinux10-node1-disk1.vdi']"
